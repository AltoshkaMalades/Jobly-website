# 🔐 ФАЙЛ ОКРУЖЕНИЯ ДЛЯ РАЗРАБОТКИ
# 
# Копируй как .env и заполни значения
# ВАЖНО: НЕ добавляй в git!
#
# Использование:
# docker-compose --env-file .env up -d
# или просто переименуй в .env и docker-compose будет использовать автоматически

# ============================================================================
# DJANGO НАСТРОЙКИ
# ============================================================================

DEBUG=True
SECRET_KEY=django-insecure-your-very-secret-key-here-change-in-production

# Разрешенные хосты (для разработки)
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# ============================================================================
# DATABASE
# ============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simulator_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# For local development: use SQLite
DATABASE_URL=sqlite:///db.sqlite3

# ============================================================================
# REDIS / CACHE
# ============================================================================

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# CELERY
# ============================================================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# ============================================================================
# EMAIL (для разработки)
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# ============================================================================
# AWS S3 (если используешь для static/media)
# ============================================================================

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# ============================================================================
# PAYMENT PROVIDERS (PAY-001, PAY-005)
# ============================================================================

