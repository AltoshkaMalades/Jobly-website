# 🔐 ФАЙЛ ОКРУЖЕНИЯ ДЛЯ РАЗРАБОТКИ
# 
# Копируй как .env и заполни значения
# ВАЖНО: НЕ добавляй в git!
#
# Использование:
# docker-compose --env-file .env up -d
# или просто переименуй в .env и docker-compose будет использовать автоматически

# ============================================================================
# DJANGO НАСТРОЙКИ
# ============================================================================

DEBUG=True
SECRET_KEY=django-insecure-your-very-secret-key-here-change-in-production

# Разрешенные хосты (для разработки)
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simulator_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django DATABASE_URL (автоматически генерируется из выше)
DATABASE_URL=postgresql://postgres:postgres@db:5432/simulator_db

# ============================================================================
# REDIS / CACHE
# ============================================================================

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# CELERY
# ============================================================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# ============================================================================
# EMAIL (для разработки)
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# ============================================================================
# AWS S3 (если используешь для static/media)
# ============================================================================

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# ============================================================================
# SECURITY (для разработки - дефолт значения)
# SEC-002: Google OAuth 2.0
GOOGLE_OAUTH2_KEY=your-google-oauth2-key-from-console.cloud.google.com
GOOGLE_OAUTH2_SECRET=your-google-oauth2-secret

# SEC-004: Google reCAPTCHA v3
# Тестовые ключи (всегда работают):
RECAPTCHA_PUBLIC_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_PRIVATE_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# SEC-007: Secret scanning (для CI/CD)
# Трufflehog будет сканировать репо перед каждым push
ENABLE_SECRET_SCANNING=true
# ============================================================================

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================================================
# ПРОЧЕЕ
# ============================================================================

LANGUAGE_CODE=ru-ru
TIME_ZONE=Asia/Almaty

# Для миграций
MIGRATION_MODULES=

# ============================================================================
# PAYMENT PROVIDERS (PAY-001, PAY-005)
# ============================================================================

# Bereke Bank Sandbox Configuration
BEREKE_SANDBOX=true
BEREKE_API_URL=https://api.berekebank-sandbox.kz
BEREKE_API_KEY=your-bereke-api-key-here
BEREKE_API_SECRET=your-bereke-webhook-secret-here
BEREKE_MERCHANT_ID=MERCHANT_001

# PayPal Sandbox Configuration
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id-here

# ============================================================================
# POSTHOG ANALYTICS (ANA-002, ANA-003, ANA-004)
# ============================================================================

# PostHog API Configuration
POSTHOG_API_KEY=your-posthog-api-key-here
POSTHOG_API_URL=https://app.posthog.com

# ============================================================================
# WEBHOOK CONFIGURATION (PAY-002)
# ============================================================================

# For local development with ngrok:
# 1. Run: ngrok http 8000
# 2. Get the public URL (https://xxxxx.ngrok.io)
# 3. Set WEBHOOK_BASE_URL to the ngrok URL
# 4. Register webhooks with payment providers using:
#    https://xxxxx.ngrok.io/api/payments/webhook/bereke
#    https://xxxxx.ngrok.io/api/payments/webhook/paypal

WEBHOOK_BASE_URL=http://localhost:8000
WEBHOOK_SECRET=your-webhook-signing-secret-here

# ============================================================================
